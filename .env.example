# ==============================================================================
# LegalLens Configuration Template
# Copy this file to .env and insert your API credentials.
# The application will automatically detect set keys.
# ==============================================================================

# Preferred LLM Provider: gemini | groq | openai | mock
DEFAULT_PROVIDER=gemini

# Google Gemini API Key (Recommended - gemini-2.0-flash / gemini-1.5-flash)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API Key (High-speed Llama-3.3-70b inference)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API Key (GPT-4o / GPT-4o-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model Overrides (Optional)
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
